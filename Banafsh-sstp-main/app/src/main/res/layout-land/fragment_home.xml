<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="56dp"
    android:paddingEnd="56dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardServer"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginEnd="100dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:focusedByDefault="true"
            android:foreground="?attr/selectableItemBackground"
            android:nextFocusRight="@id/btnConnect"
            android:contentDescription="@string/bs_choose_free"
            app:cardBackgroundColor="@color/bs_glass"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bs_glass_stroke"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◎"
                    android:textColor="@color/banafsh_cyan"
                    android:textSize="42sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/bs_choose_free"
                    android:textColor="@color/bs_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvFlag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="24sp" />
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:maxLines="2"
                    android:textColor="@color/bs_title"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:clipChildren="false"
                android:clipToPadding="false">
                <View android:id="@+id/ring" android:layout_width="290dp" android:layout_height="290dp" android:layout_gravity="center" android:background="@drawable/bg_ring" />
                <View android:id="@+id/wave1" android:layout_width="210dp" android:layout_height="210dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/bg_wave" />
                <View android:id="@+id/wave2" android:layout_width="210dp" android:layout_height="210dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/bg_wave" />
                <LinearLayout
                    android:id="@+id/btnConnect"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_connect_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusLeft="@id/cardServer"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:id="@+id/ivPower" android:layout_width="64dp" android:layout_height="64dp" android:importantForAccessibility="no" android:src="@drawable/ic_power" />
                    <TextView android:id="@+id/tvConnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#FFF4F3FF" android:textSize="25sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:id="@+id/dot" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/bg_dot" />
                <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/bs_title" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tvHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.85" android:gravity="center" android:textColor="@color/bs_title" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
