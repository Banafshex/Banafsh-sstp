<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_bp_back" app:navigationContentDescription="@string/bs_close"
        app:titleTextColor="@color/bs_ink" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/blank"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
