<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <FrameLayout android:layout_width="216dp" android:layout_height="216dp" android:layout_marginTop="12dp" android:clipChildren="false" android:clipToPadding="false">
            <View android:id="@+id/ring" android:layout_width="209dp" android:layout_height="209dp" android:layout_gravity="center" android:background="@drawable/bg_ring" />
            <View android:id="@+id/wave1" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/bg_wave" />
            <View android:id="@+id/wave2" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/bg_wave" />
            <LinearLayout
                android:id="@+id/btnConnect"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_connect_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/ivPower" android:layout_width="44dp" android:layout_height="44dp" android:importantForAccessibility="no" android:src="@drawable/ic_power" />
                <TextView android:id="@+id/tvConnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFF4F3FF" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>



            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:id="@+id/dot" android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_dot" />
                <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="19sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/tvHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:alpha="0.85" android:gravity="center" android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/bs_glass"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bs_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:alpha="0.75" android:text="@string/bs_server_address" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tvFlag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:textSize="20sp" />
                        <TextView android:id="@+id/tvAddress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:layoutDirection="ltr" android:maxLines="1" android:textAlignment="viewStart" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFree"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/bs_choose_free"
                android:textColor="@color/banafsh_ink"
                app:backgroundTint="@color/banafsh_cyan"
                app:cornerRadius="24dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="@color/bs_glass"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/bs_glass_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bs_nv_apps_title" android:textSize="14sp" android:textStyle="bold" />
                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swBypass" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.85" android:text="@string/bs_nv_apps_summary" android:textSize="12sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageApps"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/bs_nv_apps_manage"
                            android:textColor="@color/banafsh_purple"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/banafsh_purple" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="0dp"
                    app:cardBackgroundColor="@color/bs_glass"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/bs_glass_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bs_nv_sites_title" android:textSize="14sp" android:textStyle="bold" />
                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swSites" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/bs_nv_sites_tag" android:textColor="@color/banafsh_purple" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.85" android:text="@string/bs_nv_sites_summary" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bs_glass"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/bs_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bs_sc_title" android:textSize="14sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditShortcuts"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="@string/bs_sc_edit"
                            android:textColor="@color/banafsh_purple"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/shortcutRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" />
                    <TextView android:id="@+id/tvShortcutEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:alpha="0.75" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="10dp" android:text="@string/bs_sc_empty" android:textSize="12sp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
